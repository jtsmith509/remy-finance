# Names only. Real values live in your shell environment or the macOS keychain, never in the repo.

# Theta Terminal (runs locally on the Mac mini; the Terminal itself holds the ThetaData login)
THETADATA_USERNAME=
THETADATA_PASSWORD=
THETA_TERMINAL_URL=http://127.0.0.1:25503

# Massive (formerly Polygon.io): dividends, splits, ticker events, yields (DR-0014, DR-0026)
MASSIVE_API_KEY=
# Optional; default https://api.massive.com
MASSIVE_BASE_URL=

# Local data root (git-ignored)
REMY_DATA_DIR=./data
